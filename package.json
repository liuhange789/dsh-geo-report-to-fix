{
  "name": "@liuhange/dsh-geo-report-to-fix",
  "version": "0.1.0",
  "description": "GEO audit to fix pack inside DSH: fetch a URL, score AI-search friendliness (JSON-LD, llms.txt, title/meta/H1), and write a ready-to-paste llms.txt + jsonld.html. GEO 体检与自动修复：输入网址，直接产出修复文件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "geo",
    "llms.txt",
    "jsonld",
    "seo",
    "aio",
    "GEO",
    "结构化数据",
    "AI 搜索"
  ],
  "homepage": "https://github.com/liuhange789/dsh-geo-report-to-fix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-geo-report-to-fix.git"
  },
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-geo-report-to-fix/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/host.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
